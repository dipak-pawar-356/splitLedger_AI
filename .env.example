# Database (Neon PostgreSQL - Required)
DATABASE_URL="postgresql://user:password@host/splitledger?sslmode=require"

# Authentication (Clerk - Required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# AI Integration (OpenAI or OpenRouter - Required)
OPENAI_API_KEY="your_openai_or_openrouter_api_key"

# Email Notifications (Resend - Free Tier 3,000 emails/mo)
RESEND_API_KEY="your_resend_api_key"

# Cloudinary (25 GB Free Storage & Bandwidth for Receipts & Avatars - Free Tier)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Application URL (http://localhost:3000 locally, or https://your-app.vercel.app on Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
